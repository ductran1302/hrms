# Copy file này thành .env nếu muốn ghi đè cấu hình.
# docker-compose có default sẵn nên .env là tùy chọn khi chạy dev.

# --- PostgreSQL ---
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_dev_pw
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092

# --- Schema Registry ---
SCHEMA_REGISTRY_PORT=8082

# --- Keycloak ---
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Observability ---
ZIPKIN_PORT=9411
KAFKA_UI_PORT=8090
