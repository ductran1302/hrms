# Template env — copy thành .env rồi chỉnh giá trị:
#   cp .env.example .env
#
# docker-compose YÊU CẦU .env tồn tại (fail-fast `:?` — không còn default trong
# docker-compose.yml / application.yml). Devcontainer cũng nạp .env qua env_file.
#
# ⚠️ CHỈ CHO DEV/MẪU: các giá trị dưới đây là credential dev.
#    PRODUCTION: sinh giá trị ngẫu nhiên mạnh (khác hẳn giá trị mẫu),
#    KHÔNG dùng lại hrms_dev_pw / admin / hrms@123.

# --- PostgreSQL ---
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_dev_pw
POSTGRES_PORT=5432

# Password kết nối DB của các service — phải khớp POSTGRES_PASSWORD
DB_PASSWORD=hrms_dev_pw

# --- Kafka ---
KAFKA_PORT=9092

# --- Schema Registry ---
SCHEMA_REGISTRY_PORT=8082

# --- Keycloak ---
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Identity service ---
# Mật khẩu mặc định gán cho nhân viên mới tạo.
# ⚠️ Dev giữ đúng "hrms@123" vì scripts/verify-*.sh đăng nhập bằng password này.
HRMS_DEFAULT_PASSWORD=hrms@123
# Client secret của client "hrms-identity" (service account gọi Admin API) —
# PHẢI khớp "secret" trong keycloak/realm-hrms.json.
# Đổi ở cả 2 chỗ nếu thay giá trị.
HRMS_IDENTITY_CLIENT_SECRET=identity-dev-secret-change-me

# --- Observability ---
ZIPKIN_PORT=9411
KAFKA_UI_PORT=8090

# --- Swagger (app stack đặt false — tắt /v3/api-docs + /swagger-ui ngoài dev) ---
# SPRINGDOC_API_DOCS=false
# SPRINGDOC_UI=false
