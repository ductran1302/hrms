{
  "realm": "hrms",
  "enabled": true,
  "displayName": "HRMS",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>HRMS</span></div>",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "roles": {
    "realm": [
      {
        "name": "HR_ADMIN",
        "description": "Quyen quan tri nhan su toan he thong",
        "composite": false
      },
      {
        "name": "MANAGER",
        "description": "Quyen quan ly nhan vien cap truong",
        "composite": false
      },
      {
        "name": "EMPLOYEE",
        "description": "Nhan vien thuong",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "hrms-spa",
      "name": "HRMS Frontend SPA",
      "description": "React SPA dang public client, flow PKCE",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5173",
      "adminUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5173/login/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "access.token.lifespan": "900",
        "refresh.token.max.reuse": "0",
        "client.session.idle.timeouts.reset": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "hr",
      "enabled": true,
      "emailVerified": true,
      "firstName": "HR",
      "lastName": "Admin",
      "email": "hr@hrms.local",
      "credentials": [
        {
          "type": "password",
          "value": "hr@123",
          "temporary": false
        }
      ],
      "realmRoles": ["HR_ADMIN", "EMPLOYEE"]
    },
    {
      "username": "manager1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nguyen",
      "lastName": "Quan Ly",
      "email": "manager1@hrms.local",
      "credentials": [
        {
          "type": "password",
          "value": "manager@123",
          "temporary": false
        }
      ],
      "realmRoles": ["MANAGER", "EMPLOYEE"]
    },
    {
      "username": "employee1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tran",
      "lastName": "Nhan Vien",
      "email": "employee1@hrms.local",
      "credentials": [
        {
          "type": "password",
          "value": "emp@123",
          "temporary": false
        }
      ],
      "realmRoles": ["EMPLOYEE"]
    }
  ],
  "groups": [
    {
      "name": "HR",
      "path": "/HR",
      "realmRoles": ["HR_ADMIN"]
    },
    {
      "name": "Managers",
      "path": "/Managers",
      "realmRoles": ["MANAGER"]
    }
  ],
  "defaultRoles": ["offline_access", "uma_authorization", "roles", "account"]
}
