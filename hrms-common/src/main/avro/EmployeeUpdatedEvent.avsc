{
  "type": "record",
  "name": "EmployeeUpdatedEvent",
  "namespace": "com.hrms.common.avro.employee",
  "doc": "Emitted by identity-service when an employee is updated. Topic: hrms.employee.v1, subject strategy: RecordNameStrategy.",
  "fields": [
    { "name": "eventId", "type": "string", "doc": "UUID of the event - used by consumers for idempotency" },
    { "name": "eventType", "type": "string", "default": "employee.updated" },
    { "name": "occurredAt", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "employeeId", "type": "string", "doc": "UUID of the employee" },
    { "name": "employeeCode", "type": "string", "doc": "Employee code, e.g. NV0001" },
    { "name": "fullName", "type": "string" },
    { "name": "email", "type": ["null", "string"], "default": null },
    { "name": "departmentId", "type": ["null", "string"], "default": null },
    { "name": "departmentName", "type": ["null", "string"], "default": null },
    { "name": "position", "type": ["null", "string"], "default": null },
    { "name": "managerId", "type": ["null", "string"], "default": null },
    { "name": "status", "type": "string", "doc": "ACTIVE | PROBATION | TERMINATED | ..." },
    { "name": "hiredAt", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
    { "name": "actorId", "type": ["null", "string"], "default": null, "doc": "user id of the admin performing the operation" },
    { "name": "changedFields", "type": { "type": "array", "items": "string" }, "default": [], "doc": "names of fields changed in this update" }
  ]
}
